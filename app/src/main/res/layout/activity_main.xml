<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gold_bg">

    <!-- Main Dashboard ScrollView -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rootContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header: Daily Japa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/appTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="Daily Japa"
                        android:textColor="@color/gold_text"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/deviceSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BEIQI-ST Smart Ring"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvBatteryStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text=""
                            android:textColor="@color/gold_accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAltarMode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="🛕 Altar"
                    android:textColor="@color/gold_accent"
                    app:strokeColor="@color/gold_card_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTheme"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Theme"
                    android:textColor="@color/gold_accent"
                    app:strokeColor="@color/gold_card_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect"
                    android:textColor="@color/gold_accent" />
            </LinearLayout>

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/gold_card"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/gold_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <View
                        android:id="@+id/statusIndicator"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@color/status_red" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Disconnected"
                        android:textColor="@color/gold_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/syncStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ring Ready"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Purpose / Counter Selector Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchCounter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="📿 Meditation (Japa) ▾"
                    android:textColor="@color/gold_text"
                    android:textSize="13sp"
                    app:strokeColor="@color/gold_card_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCounter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="+ New"
                    android:textColor="@color/gold_accent"
                    app:strokeColor="@color/gold_card_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditCounter"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✎ Edit"
                    android:textColor="@color/text_muted"
                    app:strokeColor="@color/gold_card_stroke" />
            </LinearLayout>

            <!-- Center Hero Bead Counter with Custom Photo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/counterHeroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/gold_card"
                app:cardCornerRadius="22dp"
                app:strokeColor="@color/gold_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- User Picture / Avatar with Border -->
                    <FrameLayout
                        android:id="@+id/imageContainer"
                        android:layout_width="84dp"
                        android:layout_height="84dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/counterImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/gold_card_stroke"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                        <View
                            android:id="@+id/badgeCameraBg"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@color/gold_accent" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:gravity="center"
                            android:text="📷"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCounterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:letterSpacing="0.06"
                        android:text="Meditation (Japa)"
                        android:textColor="@color/gold_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Sacred Mantra or Intention text -->
                    <TextView
                        android:id="@+id/tvMantra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="serif"
                        android:text="Om Namah Shivaya"
                        android:textColor="@color/gold_accent"
                        android:textSize="13sp"
                        android:textStyle="italic" />

                    <!-- Bead Adjuster Row: [-1 Undo] [Current Beads] [+1 Bead] -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMinusOne"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="−1 Undo"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCurrentBeads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp"
                            android:text="0"
                            android:textColor="@color/gold_accent"
                            android:textSize="84sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlusOne"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1 Bead"
                            android:textColor="@color/gold_accent"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMalaTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bead 0 of 108 (1 Mala)"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <!-- Chanting Pacing & Session Duration -->
                    <TextView
                        android:id="@+id/tvChantPacing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="⏱️ ~6.2m / Mala • 18 beads/min • 0m today"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <!-- Smooth Progress Bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/malaProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="108"
                        android:progress="0"
                        app:indicatorColor="@color/gold_accent"
                        app:trackColor="@color/gold_card_stroke"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <!-- Action Buttons: Sync with Ring & Reset Mala -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSyncDevice"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text="🔄 Sync with Ring"
                            android:textColor="@color/gold_accent"
                            app:strokeColor="@color/gold_card_stroke" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetMala"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reset Mala"
                            android:textColor="@color/text_muted"
                            app:strokeColor="@color/gold_card_stroke" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DASHBOARD HEADER WITH STREAK BADGE & SHARE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDashboardHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="JAPA DASHBOARD"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStreakBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="🔥 1 Day Streak"
                    android:textColor="@color/gold_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareProgress"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤 Share"
                    android:textColor="@color/gold_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Row 1: Daily Count & Daily Mala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Daily Count -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDailyCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/gold_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvDailyCountTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Daily Count"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDailyCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/gold_text"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Daily Mala -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDailyMala"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/gold_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvDailyMalaTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📿 Daily Mala"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDailyMala"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/gold_accent"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Lifetime Count & Lifetime Mala -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Lifetime Count -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLifetimeCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/gold_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLifetimeCountTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♾️ Lifetime Count"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLifetimeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/gold_text"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Lifetime Mala -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLifetimeMala"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/gold_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLifetimeMalaTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆 Lifetime Mala"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLifetimeMala"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/gold_accent"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 7-DAY CONSISTENCY WEEKLY BAR CHART -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeeklyHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/gold_card"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/gold_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvWeeklyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="📊 7-DAY SADHANA HISTORY (MALAS)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- 7 Bar Columns Container -->
                    <LinearLayout
                        android:id="@+id/weeklyBarContainer"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="10dp"
                        android:gravity="bottom"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Vibration, Sound & Calibration Settings -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/gold_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/gold_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 108 Mala Vibration Alert -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMalaVibrateTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📳 Vibrate on Mala Complete"
                                android:textColor="@color/gold_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Celebration wave when reaching full target"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchMalaVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Quarter-Mala Gentle Haptics (27, 54, 81 Beads) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvQuarterVibrateTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📳 Quarter-Mala pulses (27, 54, 81 beads)"
                                android:textColor="@color/gold_text"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gentle milestone pulses to track progress eyes-closed"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchQuarterHaptics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Sound on Mala -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMalaSoundTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔔 Sacred temple bell chime on Mala complete"
                            android:textColor="@color/gold_text"
                            android:textSize="13sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchMalaSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Click Vibration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvClickVibrateTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📳 Haptic pulse on each bead"
                            android:textColor="@color/gold_text"
                            android:textSize="13sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchClickVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider4"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Wooden Bead Click Sound -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvClickSoundTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📿 Bead click sound on each bead"
                            android:textColor="@color/gold_text"
                            android:textSize="13sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchClickSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Background & Lock Screen Counting -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBgCountingTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📿 Background &amp; lock screen counting"
                                android:textColor="@color/gold_text"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shows lock screen progress; prevents sleep disconnects"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchBgCounting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider6"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Keep Screen Awake Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvKeepAwakeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌟 Keep screen awake during Japa"
                            android:textColor="@color/gold_text"
                            android:textSize="13sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchKeepAwake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider7"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/gold_card_stroke" />

                    <!-- Button Calibration & Diagnostic Feature -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCalibrationTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎯 Lock Middle Button Only"
                                android:textColor="@color/gold_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCalibrationSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Test buttons &amp; ensure side buttons are blocked"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCalibrate"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test &amp; Lock"
                            android:textColor="@color/gold_accent"
                            app:strokeColor="@color/gold_card_stroke" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- FULL-SCREEN ALTAR MODE OVERLAY (ZEN MEDITATION) -->
    <LinearLayout
        android:id="@+id/altarModeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Glowing Altar Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/altarImage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"
            app:strokeColor="@color/gold_accent"
            app:strokeWidth="2dp" />

        <!-- Counter Name & Sacred Mantra -->
        <TextView
            android:id="@+id/altarCounterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.08"
            android:text="Meditation (Japa)"
            android:textColor="@color/gold_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/altarMantra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:text="Om Namah Shivaya"
            android:textColor="@color/gold_accent"
            android:textSize="17sp"
            android:textStyle="italic" />

        <!-- Huge Glowing Bead Number -->
        <TextView
            android:id="@+id/altarCurrentBeads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="0"
            android:textColor="@color/gold_accent"
            android:textSize="108sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/altarMalaStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bead 0 of 108 • 0 Malas Today"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/altarProgressBar"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:max="108"
            android:progress="0"
            app:indicatorColor="@color/gold_accent"
            app:trackColor="@color/gold_card_stroke"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/altarPaceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⏱️ ~6.2m / Mala • 18 beads/min"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:letterSpacing="0.05"
            android:text="TAP ANYWHERE TO EXIT ALTAR MODE"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>
